{
  "name": "afl-stats",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "npm -w apps/web run dev",
    "build": "npm -w apps/web run build",
    "test": "vitest run",
    "e2e": "npm -w apps/web run e2e",
    "check": "biome check . && tsc -b",
    "format": "biome check --write .",
    "ingest": "tsx packages/ingest/src/cli.ts",
    "db:build": "tsx packages/warehouse/src/build.ts",
    "db:test": "tsx packages/warehouse/src/test.ts",
    "fixtures:seed": "tsx packages/warehouse/test/seedRaw.ts",
    "publish": "tsx packages/publish/src/cli.ts",
    "rebuild": "npm run db:build && npm run db:test && npm run publish"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.19.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
